# BuddyCore 小智服务端（xiaozhi-esp32-server）部署变量
#
# 用法：复制本文件为 deploy/server/.env 再填写真实值。.env 已被 .gitignore 忽略，
# 任何密钥都不进仓库。./start-server.sh 会读取它并据此生成
# deploy/server/data/.config.yaml（同样被忽略）。

# 时区与对外地址：云服务器改成公网 IP 或域名，脚本用它生成 OTA / WebSocket 地址
TZ=Asia/Shanghai
PUBLIC_HOST=127.0.0.1

# 部署形态：
#   local —— 本机/局域网，直接发布 8000(WS)、8003(HTTP)、8002(智控台)，设备侧走 http/ws + 端口
#   cloud —— 云服务器 + 域名，启用 deploy/server/docker-compose.cloud.yml：只发布 80/443，
#            由 Caddy 自动申请证书并按路径分流（/xiaozhi/ota/* → OTA，/xiaozhi/v1/* → WebSocket）
BUDDYCORE_STACK=local
# 可显式覆盖对外协议；cloud 栈默认 https（设备侧得到 https/wss 地址）
# PUBLIC_SCHEME=https
# Let's Encrypt 到期提醒邮箱（cloud 栈可选）
# ACME_EMAIL=you@example.com
# 智控台模式下 OTA 由 web 容器提供时，脚本会自动把 Caddy 的 OTA 上游指向它，无需手工配置

# 端口（保持上游默认；改端口需同时调整安全组/防火墙）
PORT_WS=8000
PORT_HTTP=8003
PORT_CONSOLE=8002

# 镜像：默认用上游镜像；上云前建议固定到具体版本标签
SERVER_IMAGE=ghcr.nju.edu.cn/xinnan-tech/xiaozhi-esp32-server:server_latest
WEB_IMAGE=ghcr.nju.edu.cn/xinnan-tech/xiaozhi-esp32-server:web_latest
MYSQL_IMAGE=mysql:latest
REDIS_IMAGE=redis:8.0

# 智控台数据库（仅 console profile 使用）
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=xiaozhi_esp32_server
MYSQL_USER=root

# 智控台密钥开关：
#   留空 = 轻量模式：只启动主服务，全部模块配置来自 data/.config.yaml
#   填写 = 智控台模式：额外启动 web/db/redis，服务端从智控台拉取模型与智能体配置，
#          此时 data/.config.yaml 不能再包含 selected_module（上游会报错）
# 取值：注册管理员后，智控台【参数管理】→ server.secret
MANAGER_SECRET=
MANAGER_API_URL=http://xiaozhi-esp32-server-web:8002/xiaozhi

# 大模型：火山方舟（豆包）OpenAI 兼容接口
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 id 必须用控制台里“可用”的那一个：GET /api/v3/models 会为每个模型返回 status，
# Shutdown / Retiring 的模型调用会报 404 InvalidEndpointOrModel.NotFound。
# 实测可用：doubao-seed-2-0-lite-260428（上游 config.yaml 里的 260215 在本账号为 Retiring）
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_API_KEY=

# 语音模块（轻量模式生效）：默认不花钱的本地 FunASR + EdgeTTS。
# 换成火山引擎语音时把 TTS_MODULE 改成 HuoshanDoubleStreamTTS（本仓库已用补丁
# 支持新版单一 API Key 鉴权，见 config/server/ 与 dependencies/patches/）。
LLM_MODULE=DoubaoLLM
ASR_MODULE=DoubaoStreamASRV2
TTS_MODULE=HuoshanDoubleStreamTTS

# 豆包语音新版鉴权：控制台只发一条 API Key（不是方舟的 Key），走 X-Api-Key。
# 资源与音色必须配对（实测）：
#   seed-icl-2.0 + 复刻音色（控制台“音色库”里的 S_xxxxxx）→ 本项目当前使用
#   seed-tts-2.0 + 预置 2.0 音色（*_uranus_bigtts），作为没有复刻音色时的兜底
#   volc.service_type.10029 / volc.megatts.voiceclone 是旧资源，用这条新 Key 分别 403 / 无并发额度
SPEECH_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-icl-2.0
VOLC_TTS_VOICE=S_1Q9BPMqh2
# ASR 资源：2.0 用 volc.seedasr.sauc.duration（推荐，本账号实测可用），
# 1.0 的 volc.bigasr.sauc.duration 用这条新 Key 会 403。
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# 豆包语音旧版鉴权（appid + access_token）：仅在拿不到新版 API Key 时使用，
# ASR 目前仍走这两个字段。
VOLC_APPID=
VOLC_ACCESS_TOKEN=

# 轻量模式的人格提示词文件（相对仓库根目录）；留空则不覆盖服务端默认 prompt
PERSONA_FILE=config/Lisa.Beck/SOUL.md

# 设备激活码白名单：true 时只有 deploy/server/data/activation_codes.txt 里的设备能接入
# （WebSocket 握手与 OTA 下发两处拦截）；false 放行所有设备，用于先上线门禁再逐个发码。
# 激活码在设备配网界面里填写，生成命令见 tools/gen_activation_code.py。
ACTIVATION_WHITELIST_ENABLED=false

# SenseVoice 语音识别模型：缺失时自动下载到 deploy/server/models/SenseVoiceSmall/
DOWNLOAD_SENSEVOICE_MODEL=1
SENSEVOICE_MODEL_URL=https://modelscope.cn/models/iic/SenseVoiceSmall/resolve/master/model.pt
