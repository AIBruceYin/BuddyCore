             except Exception:
                 data_json = {}
 
+            # BuddyCore：激活码白名单——只有白名单内的设备才下发服务器配置
+            # 注意：handle_post 是在 finally 里返回 response 的，所以拒绝时要把
+            # 403 的响应体赋给 response 再返回，否则会被 finally 覆盖掉。
+            activation_code = ""
+            try:
+                from core.utils.activation_whitelist import (
+                    check_activation_code_allowed,
+                    code_from_sources,
+                )
+
+                activation_code = code_from_sources(
+                    headers=request.headers, payload=data_json
+                )
