+                allowed, reason = True, f"whitelist check error: {e}"
+
+            if not allowed:
+                self.logger.bind(tag=TAG).warning(
+                    f"OTA 拒绝 device-id={device_id} "
+                    f"激活码={activation_code or '(空)'}：{reason}"
+                )
+                response = web.Response(
+                    text=json.dumps({"success": False, "message": reason}),
+                    content_type="application/json",
+                    status=403,
+                )
+                return response
+            self.logger.bind(tag=TAG).info(
+                f"OTA 激活码校验通过 激活码={activation_code or '(空)'}（{reason}）"
